# TasteMatrix Backend Configuration

# Database: SQLite by default; or Postgres e.g. postgresql://user:password@localhost:5432/tastematrix
DATABASE_URL=sqlite:///./tastematrix.db

# Authentication key required in X-Device-Key header by ESP32 / Simulator
DEVICE_KEY=tm-esp32-secret-key-2026

# Allowed frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Simulator device settings
API_URL=http://localhost:8000
DEVICE_ID=esp32-node-01
